#!/usr/bin/env bash
# bin/sysman - Main entry point for Sysman

# Get the absolute path of the project root directory.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/../lib/config.sh" && -f "$SCRIPT_DIR/../lib/services.sh" ]]; then
    # Running from a cloned repository.
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
else
    # Installed by the Makefile.
    PROJECT_ROOT="/usr/local/lib/sysman"
fi

# This application requires Bash 4 or later.
if (( BASH_VERSINFO[0] < 4 )); then
    printf "Error: Sysman requires Bash 4 or later. Current version: %s\n" "$BASH_VERSION" >&2
    exit 1
fi

# Source modular libraries.
source "$PROJECT_ROOT/lib/config.sh"
source "$PROJECT_ROOT/lib/services.sh"

# Dependency check.
if ! command -v systemctl >/dev/null 2>&1; then
    echo "Error: 'systemctl' not found. Sysman requires a systemd-based Linux system." >&2
    exit 1
fi

# Initialize application state.
if ! init_config; then
    echo "Error: Could not initialize the service history file: $RECORD_FILE" >&2
    exit 1
fi

# -------- Main Menu Loop --------
main_menu() {
    while true; do
        clear
        echo "======================================="
        echo "       🧭 Service Manager (sysman)     "
        echo "======================================="
        echo
        echo " 1) Active Services [to stop]          "
        echo " 2) Services stopped by this script    "
        echo " 3) Show Inactive/Other Services       "
        echo " 909) Exit                             "
        echo
        read -rp "Select an option: " opt

        case "$opt" in
            1) run_option1 ;;
            2) run_option2 ;;
            3) run_option3 ;;
            909) echo "Goodbye!"; exit 0 ;;
            *) echo "Try again."; sleep 1 ;;
        esac
    done
}

main_menu
